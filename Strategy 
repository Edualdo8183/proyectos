public interface EstrategiaPago {
    void pagar(double monto);
}

public class PagoConTarjeta implements EstrategiaPago {
    @Override
    public void pagar(double monto) {
        System.out.println("Pagando " + monto + " usando Tarjeta de Crédito.");
    }
}

public class PagoConPayPal implements EstrategiaPago {
    @Override
    public void pagar(double monto) {
        System.out.println("Pagando " + monto + " usando PayPal.");
    }
}

public class CarritoCompras {
    private EstrategiaPago estrategiaPago;

    public CarritoCompras(EstrategiaPago estrategiaPago) {
        this.estrategiaPago = estrategiaPago;
    }

    public void setEstrategiaPago(EstrategiaPago estrategiaPago) {
        this.estrategiaPago = estrategiaPago;
    }

    public void checkout(double monto) {
        estrategiaPago.pagar(monto);
    }
}