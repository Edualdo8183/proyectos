public class Main {
    public static void main(String[] args) {
        CarritoCompras carrito = new CarritoCompras(new PagoConTarjeta());
        carrito.checkout(100.0);

        carrito.setEstrategiaPago(new PagoConPayPal());
        carrito.checkout(200.0);
    }
} 