import java.io.Serializable;

public class Estudiante implements Serializable {
    private String nombre;
    private double nota;

    public Estudiante(String nombre, double nota) {
        this.nombre = nombre;
        this.nota = nota;
    }

    @Override
    public String toString() {
        return nombre + " - Nota: " + nota;
    }
}import java.io.*;
import java.util.ArrayList;

public class ArchivoBinario {
    private String ruta;

    public ArchivoBinario(String ruta) {
        this.ruta = ruta;
    }

    public void guardar(ArrayList<Estudiante> lista) throws IOException {
        ObjectOutputStream out = new ObjectOutputStream(new FileOutputStream(ruta));
        out.writeObject(lista);
        out.close();
    }

    public ArrayList<Estudiante> leer() throws IOException, ClassNotFoundException {
        ObjectInputStream in = new ObjectInputStream(new FileInputStream(ruta));
        ArrayList<Estudiante> lista = (ArrayList<Estudiante>) in.readObject();
        in.close();
        return lista;
    }
}import java.io.*;
import java.util.ArrayList;

public class ArchivoTexto {
    private String ruta;

    public ArchivoTexto(String ruta) {
        this.ruta = ruta;
    }

    public void guardar(ArrayList<Estudiante> lista) throws IOException {
        PrintWriter pw = new PrintWriter(new FileWriter(ruta));
        for (Estudiante e : lista) {
            pw.println(e);
        }
        pw.close();
    }
}import javax.swing.*;
import java.util.ArrayList;
import java.io.*;

public class Ventana extends JFrame {
    private ArrayList<Estudiante> estudiantes;
    private JTextArea area;
    private ArchivoBinario archBin;
    private ArchivoTexto archTxt;

    public Ventana(ArrayList<Estudiante> estudiantes, ArchivoBinario archBin, ArchivoTexto archTxt) {
        this.estudiantes = estudiantes;
        this.archBin = archBin;
        this.archTxt = archTxt;

        setTitle("Estudiantes");
        setSize(400, 300);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        area = new JTextArea();
        area.setEditable(false);
        add(new JScrollPane(area));
        crearMenu();
    }

    private void crearMenu() {
        JMenuBar barra = new JMenuBar();
        JMenu menu = new JMenu("Opciones");

        JMenuItem agregar = new JMenuItem("Agregar");
        JMenuItem guardar = new JMenuItem("Guardar");
        JMenuItem mostrar = new JMenuItem("Mostrar");
        JMenuItem guardarTxt = new JMenuItem("Guardar Texto");

        agregar.addActionListener(e -> agregarEstudiante());
        guardar.addActionListener(e -> guardarBinario());
        mostrar.addActionListener(e -> mostrarBinario());
        guardarTxt.addActionListener(e -> guardarTexto());

        menu.add(agregar);
        menu.add(guardar);
        menu.add(mostrar);
        menu.add(guardarTxt);
        barra.add(menu);
        setJMenuBar(barra);
    }

    private void agregarEstudiante() {
        String nombre = JOptionPane.showInputDialog("Nombre:");
        String notaStr = JOptionPane.showInputDialog("Nota:");
        try {
            double nota = Double.parseDouble(notaStr);
            estudiantes.add(new Estudiante(nombre, nota));
            area.append("Agregado: " + nombre + "\n");
        } catch (Exception ex) {
            area.append("Error\n");
        }
    }

    private void guardarBinario() {
        try {
            archBin.guardar(estudiantes);
            area.append("Guardado binario\n");
        } catch (IOException e) {
            area.append("Error al guardar\n");
        }
    }

    private void mostrarBinario() {
        area.setText("");
        try {
            estudiantes = archBin.leer();
            for (Estudiante e : estudiantes)
                area.append(e + "\n");
        } catch (Exception e) {
            area.append("Error al mostrar\n");
        }
    }

    private void guardarTexto() {
        try {
            archTxt.guardar(estudiantes);
            area.append("Guardado texto\n");
        } catch (IOException e) {
            area.append("Error al guardar texto\n");
        }
    }
}import java.util.ArrayList;

public class Main {
    public static void main(String[] args) {
        String rutaBin = "estudiantes.dat";
        String rutaTxt = "estudiantes.txt";

        ArchivoBinario archBin = new ArchivoBinario(rutaBin);
        ArchivoTexto archTxt = new ArchivoTexto(rutaTxt);
        ArrayList<Estudiante> lista = new ArrayList<>();

        new Ventana(lista, archBin, archTxt).setVisible(true);
    }
}