package empresa; // Asegúrate de que todas las clases están en el mismo paquete

public class Cliente {
    private String cedula;
    private String nombre;
    private String apellido;
    private String direccion;
    private String telefono;

    public Cliente(String cedula, String nombre, String apellido, String direccion, String telefono) {
        this.cedula = cedula;
        this.nombre = nombre;
        this.apellido = apellido;
        this.direccion = direccion;
        this.telefono = telefono;
    }

    public void mostrarDatos() {
        System.out.println("Cliente: " + nombre + " " + apellido + " | Cédula: " + cedula + " | Teléfono: " + telefono);
    }
}

package empresa; // Mismo paquete que Cliente.java

public class Empleado extends Cliente {
    private double sueldoBruto;

    public Empleado(String cedula, String nombre, String apellido, String direccion, String telefono, double sueldoBruto) {
        super(cedula, nombre, apellido, direccion, telefono);
        this.sueldoBruto = sueldoBruto;
    }

    @Override
    public void mostrarDatos() {
        super.mostrarDatos();
        System.out.println("Sueldo Bruto: $" + sueldoBruto);
    }
}

package empresa;

public class Main {
    public static void main(String[] args) {
        Cliente cliente1 = new Cliente("12345678", "Juan", "Pérez", "Av. Siempre Viva", "987654321");
        cliente1.mostrarDatos();

        Empleado empleado1 = new Empleado("87654321", "María", "Gómez", "Calle 123", "123456789", 2500.50);
        empleado1.mostrarDatos();
    }
}