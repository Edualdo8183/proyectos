import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;
import javax.swing.JTextArea;

public class ClaseAdaptadora extends KeyAdapter {
    private JTextArea areaTexto;
    private StringBuilder buffer;

    public ClaseAdaptadora(JTextArea areaTexto) {
        this.areaTexto = areaTexto;
        this.buffer = new StringBuilder();
    }

    @Override
    public void keyTyped(KeyEvent e) {
        char tecla = e.getKeyChar();

        if (tecla == '*') {
            System.out.println("Acción: Se presionó '*'. Cerrando programa.");
            System.exit(0);
        }

        if (tecla == KeyEvent.VK_BACK_SPACE && areaTexto.getText().length() > 0) {
            String texto = areaTexto.getText();
            areaTexto.setText(texto.substring(0, texto.length() - 1));
            buffer.setLength(Math.max(0, buffer.length() - 1));
            System.out.println("Acción: Se borró un carácter.");
        } else {
            areaTexto.append(String.valueOf(tecla));
            buffer.append(tecla);
            System.out.println("Acción: Se escribió '" + tecla + "'");
        }

        if (buffer.toString().endsWith("Limpiar")) {
            areaTexto.setText("");
            buffer.setLength(0);
            System.out.println("Acción: Se escribió 'Limpiar'. Se borró todo el texto.");
        }

        e.consume();
    }
}

import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;

public class EventosVentana extends WindowAdapter {
    @Override
    public void windowOpened(WindowEvent e) {
        System.out.println("Evento de ventana: Abierta");
    }

    @Override
    public void windowClosing(WindowEvent e) {
        System.out.println("Evento de ventana: Cerrando");
    }

    @Override
    public void windowClosed(WindowEvent e) {
        System.out.println("Evento de ventana: Cerrada");
    }

    @Override
    public void windowIconified(WindowEvent e) {
        System.out.println("Evento de ventana: Minimizada");
    }

    @Override
    public void windowDeiconified(WindowEvent e) {
        System.out.println("Evento de ventana: Restaurada");
    }

    @Override
    public void windowActivated(WindowEvent e) {
        System.out.println("Evento de ventana: Activada");
    }

    @Override
    public void windowDeactivated(WindowEvent e) {
        System.out.println("Evento de ventana: Desactivada");
    }
}

import java.awt.event.*;
import javax.swing.JTextArea;

public class EventosRaton implements MouseListener, MouseMotionListener {
    private JTextArea areaTexto;

    public EventosRaton(JTextArea areaTexto) {
        this.areaTexto = areaTexto;
    }

    @Override
    public void mouseClicked(MouseEvent e) {
        System.out.println("Mouse: Clic en posición (" + e.getX() + ", " + e.getY() + ")");
    }

    @Override
    public void mousePressed(MouseEvent e) {
        System.out.println("Mouse: Botón presionado");
    }

    @Override
    public void mouseReleased(MouseEvent e) {
        System.out.println("Mouse: Botón liberado");
    }

    @Override
    public void mouseEntered(MouseEvent e) {
        System.out.println("Mouse: Entró al área de texto");
    }

    @Override
    public void mouseExited(MouseEvent e) {
        System.out.println("Mouse: Salió del área de texto");
    }

    @Override
    public void mouseDragged(MouseEvent e) {
        System.out.println("Mouse: Arrastrando en (" + e.getX() + ", " + e.getY() + ")");
    }

    @Override
    public void mouseMoved(MouseEvent e) {
        System.out.println("Mouse: Moviéndose en (" + e.getX() + ", " + e.getY() + ")");
    }
}

import javax.swing.*;
import java.awt.*;

public class Main {
    public static void main(String[] args) {
        JFrame frame = new JFrame("Máquina de Escribir");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(400, 300);
        frame.setLayout(new BorderLayout());

        JTextArea areaTexto = new JTextArea();
        areaTexto.setLineWrap(true);
        areaTexto.setWrapStyleWord(true);
        areaTexto.setEnabled(false);  // Desactivado al inicio
        frame.add(new JScrollPane(areaTexto), BorderLayout.CENTER);

        JButton btnEscribir = new JButton("Máquina de Escribir");
        JButton btnSilencio = new JButton("Silencio");
        JButton btnSalir = new JButton("Salir");

        JPanel panelBotones = new JPanel();
        panelBotones.add(btnEscribir);
        panelBotones.add(btnSilencio);
        panelBotones.add(btnSalir);
        frame.add(panelBotones, BorderLayout.SOUTH);

        // Clases externas
        ClaseAdaptadora teclado = new ClaseAdaptadora(areaTexto);
        EventosVentana eventosVentana = new EventosVentana();
        EventosRaton eventosRaton = new EventosRaton(areaTexto);

        // Asociar eventos
        frame.addWindowListener(eventosVentana);
        areaTexto.addKeyListener(teclado);
        areaTexto.addMouseListener(eventosRaton);
        areaTexto.addMouseMotionListener(eventosRaton);

        // Botones
        btnEscribir.addActionListener(e -> {
            areaTexto.setEnabled(true);
            areaTexto.requestFocusInWindow();
            System.out.println("Acción: Escritura activada");
        });

        btnSilencio.addActionListener(e -> {
            areaTexto.setEnabled(false);
            System.out.println("Acción: Escritura desactivada");
        });

        btnSalir.addActionListener(e -> {
            System.out.println("Acción: Botón 'Salir' presionado. Cerrando programa.");
            System.exit(0);
        });

        frame.setVisible(true);
        System.out.println("Programa iniciado correctamente.");
    }
}