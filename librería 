public class RevistaControlador {
    private Revista modeloRevista;
    private Vista vista;

    public RevistaControlador(Vista vista) {
        this.vista = vista;
    }

    public void agregarRevista(int cod, String tit, String autor, String editorial) {
        modeloRevista = new Revista(cod, tit, autor, editorial);
    }

    public void listarRevista() {
        vista.mostrarMensaje("Revista: " + modeloRevista.getTitulo() + " - " + modeloRevista.getAutor() +
                             " - " + modeloRevista.getEditorial());
    }
}

