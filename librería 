import java.util.ArrayList;

public class LibroControlador {
    private ArrayList<Libro> libros = new ArrayList<>();
    private Vista vista;

    public LibroControlador(Vista vista) {
        this.vista = vista;
    }

    public void agregarLibro() {
        vista.mostrarMensaje("Código:");
        int codigo = vista.leerEntero();
        vista.mostrarMensaje("Título:");
        String titulo = vista.leerTexto();
        vista.mostrarMensaje("Autor:");
        String autor = vista.leerTexto();
        libros.add(new Libro(codigo, titulo, autor));
        vista.mostrarMensaje("Libro agregado.");
    }

    public void listarLibros() {
        if (libros.isEmpty()) {
            vista.mostrarMensaje("No hay libros registrados.");
        } else {
            for (Libro l : libros) {
                vista.mostrarMensaje(l.toString());
            }
        }
    }

    public ArrayList<Libro> getLibros() {
        return libros;
    }
}


