public class LibroControlador {
    private Libro modeloLibro;
    private Vista vista;

    public LibroControlador(Vista vista) {
        this.vista = vista;
    }

    public void agregarLibro(int cod, String tit, String autor) {
        modeloLibro = new Libro(cod, tit, autor);
    }

    public void listarLibro() {
        vista.mostrarMensaje("Libro: " + modeloLibro.getTitulo() + " - " + modeloLibro.getAutor());
    }
}


