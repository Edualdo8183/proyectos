public class Main {
    public static void main(String[] args) {
        Vista vista = new Vista();

        // Libro
        LibroControlador libroCtrl = new LibroControlador(vista);
        vista.mostrarMensaje("Ingrese datos del libro:");
        Libro libro = ingresarDatosLibro(vista);
        libroCtrl.agregarLibro(libro.getCodigo(), libro.getTitulo(), libro.getAutor());
        libroCtrl.listarLibro();

        // Revista
        RevistaControlador revistaCtrl = new RevistaControlador(vista);
        vista.mostrarMensaje("Ingrese datos de la revista:");
        Revista revista = ingresarDatosRevista(vista);
        revistaCtrl.agregarRevista(revista.getCodigo(), revista.getTitulo(),
                                   revista.getAutor(), revista.getEditorial());
        revistaCtrl.listarRevista();
    }

    public static Libro ingresarDatosLibro(Vista vista) {
        vista.mostrarMensaje("Código:");
        int cod = vista.obtenerInteger();
        vista.mostrarMensaje("Título:");
        String titulo = vista.obtenerTexto();
        vista.mostrarMensaje("Autor:");
        String autor = vista.obtenerTexto();
        return new Libro(cod, titulo, autor);
    }

    public static Revista ingresarDatosRevista(Vista vista) {
        vista.mostrarMensaje("Código:");
        int cod = vista.obtenerInteger();
        vista.mostrarMensaje("Título:");
        String titulo = vista.obtenerTexto();
        vista.mostrarMensaje("Autor:");
        String autor = vista.obtenerTexto();
        vista.mostrarMensaje("Editorial:");
        String editorial = vista.obtenerTexto();
        return new Revista(cod, titulo, autor, editorial);
    }
}