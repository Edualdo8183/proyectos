import java.util.ArrayList;

public class RevistaControlador {
    private ArrayList<Revista> revistas = new ArrayList<>();
    private Vista vista;

    public RevistaControlador(Vista vista) {
        this.vista = vista;
    }

    public void agregarRevista() {
        vista.mostrarMensaje("Código:");
        int codigo = vista.leerEntero();
        vista.mostrarMensaje("Título:");
        String titulo = vista.leerTexto();
        vista.mostrarMensaje("Autor:");
        String autor = vista.leerTexto();
        vista.mostrarMensaje("Editorial:");
        String editorial = vista.leerTexto();
        revistas.add(new Revista(codigo, titulo, autor, editorial));
        vista.mostrarMensaje("Revista agregada.");
    }

    public void listarRevistas() {
        if (revistas.isEmpty()) {
            vista.mostrarMensaje("No hay revistas registradas.");
        } else {
            for (Revista r : revistas) {
                vista.mostrarMensaje(r.toString());
            }
        }
    }

    public ArrayList<Revista> getRevistas() {
        return revistas;
    }
}

