public class Libro {
    protected int codigo;
    protected String titulo;
    protected String autor;

    public Libro() {
        // Constructor vacío requerido para herencia sin super
    }

    public Libro(int codigo, String titulo, String autor) {
        this.codigo = codigo;
        this.titulo = titulo;
        this.autor = autor;
    }

    public String toString() {
        return "Libro: " + titulo + " - " + autor;
    }
}


