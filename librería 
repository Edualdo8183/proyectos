import java.util.ArrayList;

public class Main {
    public static void main(String[] args) {
        Vista vista = new Vista();
        LibroControlador libroCtrl = new LibroControlador(vista);
        RevistaControlador revistaCtrl = new RevistaControlador(vista);

        int opcion = 0;
        while (opcion != 3) {
            vista.mostrarMenu();
            opcion = vista.leerEntero();

            switch (opcion) {
                case 1:
                    vista.mostrarMensaje("¿Agregar (1) Libro o (2) Revista?");
                    int tipo = vista.leerEntero();
                    if (tipo == 1) {
                        libroCtrl.agregarLibro();
                    } else if (tipo == 2) {
                        revistaCtrl.agregarRevista();
                    } else {
                        vista.mostrarMensaje("Opción inválida.");
                    }
                    break;
                case 2:
                    vista.mostrarMensaje("¿Ver lista de (1) Libros, (2) Revistas o (3) Ambos?");
                    int verTipo = vista.leerEntero();
                    if (verTipo == 1) {
                        libroCtrl.listarLibros();
                    } else if (verTipo == 2) {
                        revistaCtrl.listarRevistas();
                    } else if (verTipo == 3) {
                        ArrayList<Libro> todos = new ArrayList<>();
                        todos.addAll(libroCtrl.getLibros());
                        todos.addAll(revistaCtrl.getRevistas());

                        if (todos.isEmpty()) {
                            vista.mostrarMensaje("No hay elementos registrados.");
                        } else {
                            for (Libro l : todos) {
                                vista.mostrarMensaje(l.toString());
                            }
                        }
                    } else {
                        vista.mostrarMensaje("Opción inválida.");
                    }
                    break;
                case 3:
                    vista.mostrarMensaje("Saliendo...");
                    break;
                default:
                    vista.mostrarMensaje("Opción inválida.");
            }
        }
    }
}