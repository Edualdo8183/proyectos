package Modelos;

public class Producto {
    private int id;
    private String nombre;
    private double precio;
    private int stock;

    public Producto(int id, String nombre, double precio, int stock) {
        this.id = id;
        this.nombre = nombre;
        this.precio = precio;
        this.stock = stock;
    }

    public int getId() {
        return id;
    }

    public String getNombre() {
        return nombre;
    }

    public double getPrecio() {
        return precio;
    }

    public int getStock() {
        return stock;
    }

    @Override
    public String toString() {
        return "ID: " + id +
               ", Nombre: " + nombre +
               ", Precio: $" + precio +
               ", Stock: " + stock;
    }
}

package Controlador;

import Modelos.Producto;
import java.util.List;

public class ControlProducto {
    private List<Producto> productos;

    public ControlProducto(List<Producto> productos) {
        this.productos = productos;
    }

    public void agregarProducto(int id, String nombre, double precio, int stock) {
        Producto producto = new Producto(id, nombre, precio, stock);
        productos.add(producto);
    }

    public List<Producto> listarProductos() {
        return productos;
    }

    public Producto buscarProductoPorId(int id) {
        for (Producto producto : productos) {
            if (producto.getId() == id) {
                return producto;
            }
        }
        return null;
    }
}

package Vista;

import Controlador.ControlProducto;
import Modelos.Producto;
import javax.swing.*;
import java.util.List;
import java.util.ArrayList;

public class VistaProducto {
    private ControlProducto control;

    public VistaProducto() {
        List<Producto> productos = new ArrayList<>();
        this.control = new ControlProducto(productos);
    }

    public void mostrarMenu() {
        int opcion;
        do {
            String[] opciones = {"Agregar producto", "Listar productos", "Buscar producto por ID", "Salir"};
            opcion = JOptionPane.showOptionDialog(
                    null,
                    "Seleccione una opción",
                    "E-commerce",
                    JOptionPane.DEFAULT_OPTION,
                    JOptionPane.INFORMATION_MESSAGE,
                    null,
                    opciones,
                    opciones[0]
            );

            switch (opcion) {
                case 0 -> agregarProducto();
                case 1 -> listarProductos();
                case 2 -> buscarProductoPorId();
                case 3 -> JOptionPane.showMessageDialog(null, "Gracias por usar el sistema. ¡Hasta luego!");
                default -> JOptionPane.showMessageDialog(null, "Opción no válida.");
            }
        } while (opcion != 3);
    }

    private void agregarProducto() {
        try {
            int id = Integer.parseInt(JOptionPane.showInputDialog("Ingrese ID del producto:"));
            String nombre = JOptionPane.showInputDialog("Ingrese nombre del producto:");
            double precio = Double.parseDouble(JOptionPane.showInputDialog("Ingrese precio del producto:"));
            int stock = Integer.parseInt(JOptionPane.showInputDialog("Ingrese stock del producto:"));

            control.agregarProducto(id, nombre, precio, stock);
            JOptionPane.showMessageDialog(null, "Producto agregado correctamente.");
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(null, "Error: Verifique que ID, precio y stock sean números válidos.");
        }
    }

    private void listarProductos() {
        List<Producto> lista = control.listarProductos();
        if (lista.isEmpty()) {
            JOptionPane.showMessageDialog(null, "No hay productos registrados.");
        } else {
            StringBuilder mensaje = new StringBuilder("**** Lista de Productos ****\n");
            for (Producto producto : lista) {
                mensaje.append(producto.toString()).append("\n");
            }
            JOptionPane.showMessageDialog(null, mensaje.toString());
        }
    }

    private void buscarProductoPorId() {
        try {
            int id = Integer.parseInt(JOptionPane.showInputDialog("Ingrese ID del producto a buscar:"));
            Producto producto = control.buscarProductoPorId(id);
            if (producto != null) {
                JOptionPane.showMessageDialog(null, producto.toString());
            } else {
                JOptionPane.showMessageDialog(null, "Producto no encontrado.");
            }
        } catch (NumberFormatException e) {
            JOptionPane.showMessageDialog(null, "Error: Ingrese un número válido para el ID.");
        }
    }
}