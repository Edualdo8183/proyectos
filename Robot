public class Robot {
    private Cabeza cabeza;
    private Extremidades[] extremidades;

    public Robot(Cabeza cabeza, Extremidades[] extremidades) {
        this.cabeza = cabeza;
        this.extremidades = extremidades;
    }

    public void iniciar() {
        cabeza.analizar();
        cabeza.detectar();
        cabeza.girar();
        for (Extremidades e : extremidades) {
            e.mover();

            // Llamamos métodos específicos si la instancia lo permite
            if (e instanceof Brazo) {
                ((Brazo) e).activar();
            } else if (e instanceof Herramienta) {
                ((Herramienta) e).intercambiar("nueva herramienta");
            }
        }
    }

    public Cabeza getCabeza() {
        return cabeza;
    }

    public void setCabeza(Cabeza cabeza) {
        this.cabeza = cabeza;
    }

    public Extremidades[] getExtremidades() {
        return extremidades;
    }

    public void setExtremidades(Extremidades[] extremidades) {
        this.extremidades = extremidades;
    }
} 

