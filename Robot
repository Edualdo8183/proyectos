public class Cabeza {
    private String vision;
    private String resolucion;

    public Cabeza(String vision, String resolucion) {
        this.vision = vision;
        this.resolucion = resolucion;
    }

    public void analizar() {
        System.out.println("Analizando el entorno con visión " + vision + " y resolución " + resolucion);
    }

    public void detectar() {
        System.out.println("Detectando objetos...");
    }

    public void girar() {
        System.out.println("Girando la cabeza.");
    }

    public String getVision() {
        return vision;
    }

    public void setVision(String vision) {
        this.vision = vision;
    }

    public String getResolucion() {
        return resolucion;
    }

    public void setResolucion(String resolucion) {
        this.resolucion = resolucion;
    }
}


public abstract class Extremidades {
    protected double peso;
    protected String material;

    public void setPeso(double peso) {
        this.peso = peso;
    }

    public double getPeso() {
        return peso;
    }

    public void setMaterial(String material) {
        this.material = material;
    }

    public String getMaterial() {
        return material;
    }

    public abstract void mover();
}

public class Piernas extends Extremidades {
    private double longitud;

    public Piernas(double peso, String material, double longitud) {
        this.peso = peso;
        this.material = material;
        this.longitud = longitud;
    }

    @Override
    public void mover() {
        System.out.println("Las piernas con longitud " + longitud + " cm están caminando.");
    }

    public double getLongitud() {
        return longitud;
    }

    public void setLongitud(double longitud) {
        this.longitud = longitud;
    }
}