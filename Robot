public class Herramienta extends Extremidades {
    private boolean pinza;
    private boolean taladro;
    private boolean destornillador;

    public Herramienta(double peso, String material, boolean pinza, boolean taladro, boolean destornillador) {
        this.peso = peso;
        this.material = material;
        this.pinza = pinza;
        this.taladro = taladro;
        this.destornillador = destornillador;
    }

    @Override
    public void mover() {
        System.out.println("La herramienta está operando.");
    }

    public void intercambiar(String nuevaHerramienta) {
        System.out.println("Intercambiando a herramienta: " + nuevaHerramienta);
    }

    public boolean isPinza() {
        return pinza;
    }

    public void setPinza(boolean pinza) {
        this.pinza = pinza;
    }

    public boolean isTaladro() {
        return taladro;
    }

    public void setTaladro(boolean taladro) {
        this.taladro = taladro;
    }

    public boolean isDestornillador() {
        return destornillador;
    }

    public void setDestornillador(boolean destornillador) {
        this.destornillador = destornillador;
    }
}

