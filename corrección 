package controlador;

import modelo.CalculoModelo;
import vista.CalculoVista;

import javax.swing.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class CalculoControlador {
    private final CalculoModelo modelo;
    private final CalculoVista vista;

    public CalculoControlador(CalculoModelo modelo, CalculoVista vista) {
        this.modelo = modelo;
        this.vista = vista;

        this.vista.btnCalcular.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                calcular();
            }
        });
    }

    private void calcular() {
        try {
            int asistentes = Integer.parseInt(vista.txtAsistentes.getText());
            int formaPago = vista.cbFormaPago.getSelectedIndex() + 1;

            double total = modelo.calcularTotal(asistentes);
            double descuento = modelo.calcularDescuento(total, formaPago);
            double precioFinal = modelo.calcularPrecioFinal(total, descuento);

            vista.lblTotal.setText("Total: $" + total);
            vista.lblDescuento.setText("Descuento: $" + descuento);
            vista.lblFinal.setText("Precio Final: $" + precioFinal);
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(vista, "Ingrese un número válido de asistentes.");
        }
    }
}


