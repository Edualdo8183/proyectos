package modelo;

public class CalculoModelo {
    private final double precioEntrada = 12;

    public double calcularTotal(int asistentes) {
        return precioEntrada * asistentes;
    }

    public double calcularDescuento(double total, int formaPago) {
        double porcentaje = switch (formaPago) {
            case 1 -> 5;     // Cheque
            case 2 -> 12;    // Efectivo
            default -> 0;    // Otra
        };
        return total * porcentaje / 100;
    }

    public double calcularPrecioFinal(double total, double descuento) {
        return total - descuento;
    }
}


